# --------------------------------------------------
# Trade Pipeline - Example Terraform Variables
# Copy this file to terraform.tfvars and fill in your values
# --------------------------------------------------

# Snowflake connection
snowflake_account     = "your_account_locator"
snowflake_user        = "YOUR_USERNAME"
snowflake_role        = "YOUR_ROLE"
snowflake_warehouse   = "YOUR_WAREHOUSE"
snowflake_authenticator = "snowflake"
# snowflake_password is sensitive - set via environment variable:
# export TF_VAR_snowflake_password="your_password"

# Target environment
database_name = "YOUR_DATABASE"
schema_name   = "YOUR_SCHEMA"

# Pipeline configuration
notification_integration_name = "TRADE_PIPELINE_EMAIL_NI"
alert_email_recipients        = "ops-team@yourcompany.com"
environment                   = "dev"

tags = {
  Team    = "Data Engineering"
  Project = "Trade Pipeline"
}
